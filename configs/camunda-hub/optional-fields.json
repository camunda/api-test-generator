{
  "$comment": "Operations that also get a success-path test sending optional request fields and asserting the response echoes them. Not listed, with the reason: organizationPublic can only be set on element-template versions (Hub rejects any modification on a BPMN file), replaceWorkspaceEnvironments needs an environment that exists in the Hub, and createClusterRegistration answers 204 with no body to echo; all three are tracked in the optional-fields issue. before: setup calls run between the target's own chain and the target; extractAs stores a response field under another variable so a second resource does not overwrite the first one's key; an echo value \"${xVar}\" is the value stored in that variable. readBack: a GET run after the target whose response must echo the given values, proving the change persisted and not only that the request was echoed. A readBack echo field may be a dotted path into a wrapped resource, such as folder.parentFolderKey.",
  "variants": [
    {
      "operationId": "createWorkspace",
      "name": "description",
      "body": {
        "description": "Created with an optional description."
      },
      "echo": {
        "description": "Created with an optional description."
      }
    },
    {
      "operationId": "updateWorkspace",
      "name": "description",
      "body": {
        "description": "Updated optional description."
      },
      "echo": {
        "description": "Updated optional description."
      },
      "readBack": {
        "operationId": "getWorkspace",
        "echo": {
          "workspace.description": "Updated optional description."
        }
      }
    },
    {
      "operationId": "createVersion",
      "name": "description",
      "body": {
        "description": "Version with an optional description.",
        "organizationPublic": false
      },
      "echo": {
        "description": "Version with an optional description.",
        "organizationPublic": false
      }
    },
    {
      "operationId": "updateVersion",
      "name": "description",
      "body": {
        "description": "Updated version description."
      },
      "echo": {
        "description": "Updated version description."
      },
      "readBack": {
        "operationId": "getVersion",
        "echo": {
          "description": "Updated version description."
        }
      }
    },
    {
      "operationId": "createProjectSnapshot",
      "name": "description",
      "body": {
        "description": "Snapshot with an optional description."
      },
      "echo": {
        "description": "Snapshot with an optional description."
      }
    },
    {
      "operationId": "updateProjectSnapshot",
      "name": "description",
      "body": {
        "description": "Updated snapshot description."
      },
      "echo": {
        "description": "Updated snapshot description."
      },
      "readBack": {
        "operationId": "getProjectSnapshot",
        "echo": {
          "projectSnapshot.description": "Updated snapshot description."
        }
      }
    },
    {
      "operationId": "updateFolder",
      "name": "move under another folder",
      "before": [
        {
          "operationId": "createFolder",
          "extractAs": {
            "folderKey": "otherFolderKeyVar"
          }
        }
      ],
      "body": {
        "parentFolderKey": "${otherFolderKeyVar}"
      },
      "echo": {
        "parentFolderKey": "${otherFolderKeyVar}"
      },
      "readBack": {
        "operationId": "getFolder",
        "echo": {
          "folder.parentFolderKey": "${otherFolderKeyVar}"
        }
      }
    },
    {
      "operationId": "updateFolder",
      "name": "move to project root",
      "before": [
        {
          "operationId": "createFolder",
          "body": {
            "parentFolderKey": "${folderKeyVar}"
          }
        }
      ],
      "body": {
        "parentFolderKey": null
      },
      "echo": {
        "parentFolderKey": null
      },
      "readBack": {
        "operationId": "getFolder",
        "echo": {
          "folder.parentFolderKey": null
        }
      }
    },
    {
      "operationId": "submitProjectSnapshotReview",
      "name": "comment",
      "body": {
        "comment": "Reviewed by the generated suite."
      },
      "echo": {
        "comment": "Reviewed by the generated suite."
      }
    },
    {
      "operationId": "restoreVersion",
      "name": "element template version",
      "chainBodies": {
        "createFile": {
          "type": "element-template",
          "content": "{\"$schema\":\"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json\",\"name\":\"Hub API test template\",\"id\":\"io.camunda.test.hub-api-tests.element-template\",\"appliesTo\":[\"bpmn:Task\"],\"properties\":[],\"version\":1}"
        }
      },
      "body": {
        "version": 2
      },
      "echo": {
        "fileKey": "${fileKeyVar}"
      }
    }
  ],
  "untested": [
    {
      "operationId": "updateVersion",
      "field": "organizationPublic",
      "issue": "https://github.com/camunda/api-test-generator/issues/655",
      "reason": "Setting it to true publishes the element template id to the whole organization, which makes every later private version of that id answer 409, so it needs a template id that is unique per run (not available yet)."
    },
    {
      "operationId": "replaceWorkspaceEnvironments",
      "field": "environmentIds",
      "issue": "https://github.com/camunda/api-test-generator/issues/655",
      "reason": "The Hub has no environments to assign."
    },
    {
      "operationId": "createClusterRegistration",
      "field": "clusterId, profiles, properties",
      "issue": "https://github.com/camunda/api-test-generator/issues/655",
      "reason": "Answers 204 with no body to echo; needs a read-back and cleanup."
    }
  ]
}
